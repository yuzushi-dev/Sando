{
  "id": "tool-suite",
  "description": "Large Read, Grep, git, npm, and cargo-like outputs with location-aware facts and tail failures.",
  "events": [
    {
      "id": "read-head-middle-tail",
      "toolName": "Read",
      "path": "src/service.mjs",
      "selector": true,
      "requiredFacts": [
        { "value": "READ_HEAD_FACT", "location": "head" },
        { "value": "READ_MIDDLE_FACT", "location": "middle" },
        { "value": "READ_TAIL_FACT", "location": "tail" }
      ],
      "output": {
        "prefix": "READ_HEAD_FACT\nexport function service(input) {\n",
        "repeat": "  const line = input.trim();\nREAD_MIDDLE_FACT\n",
        "count": 180,
        "suffix": "}\nREAD_TAIL_FACT\n"
      }
    },
    {
      "id": "grep-head-middle-tail",
      "toolName": "Grep",
      "path": "src/",
      "requiredFacts": [
        { "value": "GREP_HEAD_FACT", "location": "head" },
        { "value": "GREP_MIDDLE_FACT", "location": "middle" },
        { "value": "GREP_TAIL_FACT", "location": "tail" }
      ],
      "output": {
        "prefix": "GREP_HEAD_FACT\nsrc/a.mjs:1:match\n",
        "repeat": "src/repeated.mjs:42:GREP_MIDDLE_FACT\n",
        "count": 180,
        "suffix": "src/z.mjs:99:GREP_TAIL_FACT\n"
      }
    },
    {
      "id": "git-tail-error",
      "toolName": "Bash",
      "command": "git diff --stat",
      "requiredFacts": [
        { "value": "GIT_HEAD_FACT", "location": "head" },
        { "value": "GIT_MIDDLE_FACT", "location": "middle" },
        { "value": "git error: exit 1", "location": "tail" }
      ],
      "output": {
        "prefix": "GIT_HEAD_FACT\n git status --short\n",
        "repeat": "changed file | 1 +\nGIT_MIDDLE_FACT\n",
        "count": 180,
        "suffix": "git error: exit 1\n"
      }
    },
    {
      "id": "npm-tail-error",
      "toolName": "Bash",
      "command": "npm test",
      "requiredFacts": [
        { "value": "NPM_HEAD_FACT", "location": "head" },
        { "value": "NPM_MIDDLE_FACT", "location": "middle" },
        { "value": "npm ERR! code EAI_AGAIN", "location": "tail" }
      ],
      "output": {
        "prefix": "NPM_HEAD_FACT\n> test\n",
        "repeat": "passing test\nNPM_MIDDLE_FACT\n",
        "count": 180,
        "suffix": "npm ERR! code EAI_AGAIN\n"
      }
    },
    {
      "id": "cargo-tail-error",
      "toolName": "Bash",
      "command": "cargo test",
      "requiredFacts": [
        { "value": "CARGO_HEAD_FACT", "location": "head" },
        { "value": "CARGO_MIDDLE_FACT", "location": "middle" },
        { "value": "error: could not compile", "location": "tail" }
      ],
      "output": {
        "prefix": "CARGO_HEAD_FACT\nCompiling bounded v0.1.0\n",
        "repeat": "running 1 test\nCARGO_MIDDLE_FACT\n",
        "count": 180,
        "suffix": "error: could not compile bounded\n"
      }
    }
  ]
}
