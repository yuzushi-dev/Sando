{
  "id": "read-structural",
  "description": "Large code read whose declarations preserve the required head and tail facts.",
  "events": [
    {
      "id": "read-structural-1",
      "toolName": "Read",
      "path": "src/service.mjs",
      "requiredFacts": ["READ_HEAD_FACT", "READ_TAIL_FACT"],
      "output": {
        "prefix": "export const READ_HEAD_FACT = 'READ_HEAD_FACT';\n",
        "repeat": "// implementation noise\n",
        "count": 150,
        "suffix": "export const READ_TAIL_FACT = 'READ_TAIL_FACT';\n"
      }
    }
  ]
}
