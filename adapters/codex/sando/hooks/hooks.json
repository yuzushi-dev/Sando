{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$XDG_CONFIG_HOME\"; [ -n \"$d\" ] || d=\"$HOME/.config\"; if [ -e \"$d/sando/session-start.done\" ]; then echo '{}'; else exec node \"${PLUGIN_ROOT}/hooks/session-start.mjs\"; fi",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|exec_command|shell_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/pre-tool-use.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/post-tool-use.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/provider-usage.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
