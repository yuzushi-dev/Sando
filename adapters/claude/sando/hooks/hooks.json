{
  "modules": [
    "./register.mjs"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$XDG_CONFIG_HOME\"; [ -n \"$d\" ] || d=\"$HOME/.config\"; if [ -e \"$d/sando/session-start.done\" ]; then echo '{}'; else exec node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs\"; fi",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$XDG_CONFIG_HOME\"; [ -n \"$d\" ] || d=\"$HOME/.config\"; if [ -e \"$d/sando/user-prompt-submit.done\" ]; then echo '{}'; else exec node \"${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-submit.mjs\"; fi",
            "timeout": 1
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/post-tool-use.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/provider-usage.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
